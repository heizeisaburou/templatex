#!/bin/sh
# Rechaza el push de ramas cuyo nombre no cumple la nomenclatura del proyecto.
#
# Se activa con:  git config core.hooksPath .githooks
set -eu

script="$(git rev-parse --show-toplevel)/scripts/check-branch-name.sh"
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
	# Un borrado de rama llega con local_sha a ceros: no hay nombre que validar.
	case "$local_sha" in
	*[!0]*) ;;
	*) continue ;;
	esac

	case "$remote_ref" in
	refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
	*) continue ;;
	esac

	# Se invoca con sh en lugar de ejecutarlo directamente: así no depende del
	# bit de ejecución ni de cómo interprete el shebang cada plataforma.
	sh "$script" "$branch" || status=1
done

exit "$status"
