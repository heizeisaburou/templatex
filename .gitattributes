# Normaliza los finales de línea en el repositorio.
* text=auto

# Los scripts se ejecutan con sh, también en Windows a través del shell que
# incluye Git for Windows. Con finales de línea CRLF, sh falla con
# "bad interpreter: /bin/sh^M". Estos archivos se registran siempre con LF,
# sin importar la configuración de core.autocrlf de cada clon.
*.sh text eol=lf
.githooks/* text eol=lf
